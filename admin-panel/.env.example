# ==========================================
# SUPABASE & PRISMA ENVIRONMENT VARIABLES
# ==========================================

# 1. PRISMA DATABASE CONNECTION
# Connects to Supabase PostgreSQL via connection pooling (Transaction mode)
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database (Used for Prisma migrations only)
# Change the port from 6543 to 5432
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. SUPABASE API KEYS
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhb... (very long string)"
